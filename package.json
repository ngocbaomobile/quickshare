{
  "name": "@ngocbaongo/quickshare",
  "version": "1.0.2",
  "description": "Bi-directional clipboard and file transfer between macOS, Windows, iOS, and Android over local Wi-Fi and Cloudflare Tunnel.",
  "main": "server.js",
  "bin": {
    "quickshare": "bin/cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "daemon": "node daemon.js",
    "stop": "kill -9 $(lsof -t -i :5050) 2>/dev/null || true",
    "benchmark": "node benchmark.js",
    "test": "node test-storage.js"
  },
  "keywords": [
    "quickshare",
    "airdrop",
    "file-transfer",
    "clipboard-sync",
    "cross-platform",
    "macos",
    "windows",
    "ios",
    "android"
  ],
  "author": "ngocbaomobile",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngocbaomobile/quickshare.git"
  },
  "bugs": {
    "url": "https://github.com/ngocbaomobile/quickshare/issues"
  },
  "homepage": "https://github.com/ngocbaomobile/quickshare#readme",
  "files": [
    "bin",
    "public",
    "server.js",
    "daemon.js"
  ],
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "qrcode-terminal": "^0.12.0"
  }
}
